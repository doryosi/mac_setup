{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "allow",
      "*git rebase*": "ask",
      "*git reset*": "ask",
      "*rm *-rf*": "deny",
      "*rm *-fr*": "deny",
      "*rm *-r *-f*": "deny",
      "*rm *-f *-r*": "deny",
      "*rm *--recursive*--force*": "deny",
      "*rm *--force*--recursive*": "deny"
    }
  }
}
